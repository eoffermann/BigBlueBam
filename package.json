{
  "name": "bigbluebam",
  "private": true,
  "version": "1.0.0",
  "description": "Web-based multi-user Kanban project planning tool",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "pnpm --filter @bigbluebam/e2e test:playwright",
    "test:e2e:b3": "pnpm --filter @bigbluebam/e2e test:b3",
    "test:e2e:ui": "pnpm --filter @bigbluebam/e2e test:ui",
    "test:e2e:report": "pnpm --filter @bigbluebam/e2e report",
    "clean": "turbo run clean",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:build": "docker compose build",
    "db:migrate": "docker compose run --rm migrate",
    "db:check": "node scripts/db-check.mjs",
    "seed": "node scripts/seed-all.mjs",
    "seed:gilligan": "node scripts/seed-gilligan/run-all.mjs",
    "avatars:build": "node scripts/build-avatar-thumbnails.mjs && node scripts/build-avatar-manifest.mjs",
    "help:index": "node scripts/help/build-help-index.mjs",
    "help:check": "node scripts/help/build-help-index.mjs --check",
    "check:bolt-catalog": "node scripts/check-bolt-catalog.mjs",
    "check:permission-catalog": "node scripts/check-permission-catalog.mjs",
    "check:env-hints": "node scripts/check-env-hints.mjs",
    "check:app-completeness": "node scripts/check-app-completeness.mjs",
    "permissions:codegen": "node scripts/generate-permission-manifest.mjs && node scripts/build-permission-codegen.mjs",
    "lint:migrations": "node scripts/lint-migrations.mjs",
    "db:generate": "pnpm --filter @bigbluebam/api db:generate",
    "db:push": "pnpm --filter @bigbluebam/api db:push",
    "docs:screenshots": "node scripts/docs/capture.mjs",
    "docs:extract": "node scripts/docs/extract.mjs",
    "docs:catalog": "node scripts/docs/build-docs-catalog.mjs",
    "docs:catalog:check": "node scripts/docs/build-docs-catalog.mjs --check",
    "docs:compose": "node scripts/docs/compose.mjs",
    "docs:publish": "node scripts/docs/publish.mjs",
    "docs:readme": "node scripts/docs/publish.mjs --readme-only",
    "docs:readme:check": "node scripts/docs/publish.mjs --check",
    "docs:manual": "node scripts/docs/build-manual.mjs",
    "docs:manual:check": "node scripts/docs/build-manual.mjs --check",
    "docs:generate": "node scripts/docs/generate.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.59.1",
    "argon2": "^0.41.1",
    "playwright": "^1.59.1",
    "postgres": "^3.4.0",
    "sharp": "^0.33.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
