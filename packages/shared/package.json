{
  "name": "@bigbluebam/shared",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./bulwark-arm-key": {
      "types": "./dist/bulwark-arm-key.d.ts",
      "import": "./dist/bulwark-arm-key.js",
      "require": "./dist/bulwark-arm-key.cjs"
    },
    "./visibility-client": {
      "types": "./dist/visibility-client.d.ts",
      "import": "./dist/visibility-client.js",
      "require": "./dist/visibility-client.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
