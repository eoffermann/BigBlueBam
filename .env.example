# ─── Required ────────────────────────────────────────────────
POSTGRES_USER=bigbluebam
POSTGRES_PASSWORD=change-me-in-production
REDIS_PASSWORD=change-me-in-production
MINIO_ROOT_USER=change-me-in-production
MINIO_ROOT_PASSWORD=change-me-in-production
SESSION_SECRET=generate-a-random-string-at-least-32-chars
# HB-7: Shared secret between helpdesk-api and the BBB /internal/helpdesk/*
# surface. Must be 32+ chars. Generate with e.g. `openssl rand -hex 32`.
INTERNAL_HELPDESK_SECRET=changeme-generate-a-32-char-random-string-for-production

# Wave 0.2: shared secret for cross-service internal POSTs, including the
# mcp-server /tools/call route and the Bolt ingest X-Internal-Secret check.
# Must be 32+ chars. Generate with e.g. `openssl rand -hex 32`.
INTERNAL_SERVICE_SECRET=changeme-generate-a-32-char-random-string-for-production
# Bin (storage backbone): 32-byte master key for envelope-encrypting per-org
# provider secrets (Bin master §15). Required by bin-api in production; back
# with a KMS in cloud deployments. Generate with e.g. `openssl rand -hex 32`.
BIN_SECRETS_KEY=changeme-generate-a-32-char-random-string-for-production
# Key identifier stored on each encrypted secret to support rotation.
BIN_SECRETS_KEY_ID=local-1
# Bin virus scanning (worker bin-av-scan job). These are the FALLBACK layer:
# SuperUser Console → Platform → Virus scanning writes `av.scan_mode` /
# `av.clamav_host` / `av.clamav_port` into system_settings, which OVERRIDE
# these env vars within ~30s. Mode: eicar (default, dependency-free EICAR
# signature scan) | clamav (stream to clamd at CLAMAV_HOST:CLAMAV_PORT) | off.
BIN_AV_SCAN_MODE=eicar
CLAMAV_HOST=
CLAMAV_PORT=3310
# Platform default for "may a user work with a file before its AV scan
# completes?" Off by default (serving is gated until clean/skipped). Overridden
# by system_settings `av.allow_unscanned_access` and by a per-org override; an
# admin/SuperUser can also persistently clear a specific false-positive block.
BIN_ALLOW_UNSCANNED_ACCESS=false
# Blip: server-side pepper mixed into the public /blip/ingest/ endpoint's
# token/HMAC so inbound payloads can be verified without a session. Required
# by blip-api in production. Generate with e.g. `openssl rand -hex 32`.
BLIP_INGEST_PEPPER=blip-dev-ingest-pepper-change-me
# Wave 0.2: bearer token the mcp-server /tools/call route uses when it
# proxies through ApiClient. Create with:
#   docker compose exec api node dist/cli.js create-service-account \
#     --name mcp-internal --org-slug <your-org-slug>
# Paste the printed bbam_svc_ token here.
MCP_INTERNAL_API_TOKEN=

# ─── Optional Overrides ─────────────────────────────────────
# API_PORT=4000
# MCP_PORT=3001
# Host-port bindings. The deploy script (scripts/deploy/main.mjs) walks you
# through customizing these if any conflict with services already running on
# the host — common on NAS systems where 80/443 are taken by the device
# admin UI and 7880/7881 may collide with existing media services. Set them
# by hand here as an alternative. Container-internal ports stay fixed; only
# the host-side number changes.
# HTTP_PORT=80
# HTTPS_PORT=443
# LIVEKIT_RTC_PORT=7880
# LIVEKIT_TCP_PORT=7881
# ─── LiveKit network addressing (calls / Bureau / Banter media) ────
# All of this is AUTO-DETECTED — these vars are overrides for unusual
# setups, not required configuration. scripts/livekit/render-config.mjs
# detects the host's LAN IP (deploy script / host one-liner) and the
# public IP (re-checked by the livekit-config service on every
# `docker compose up`, plus an hourly drift monitor in the worker that
# writes a warning to the SuperUser Log if the public IP rotates).
# Connectivity is negotiated per-client by full ICE: the server probes
# every client's own addresses, so LAN and remote callers work
# simultaneously without telling the software where anyone is.
#
# UDP media range. The same value drives the docker port mapping AND
# the rendered LiveKit config, so they cannot drift apart. The default
# dodges Windows' reserved 50000-50259 range.
# LIVEKIT_UDP_PORT_RANGE=51000-51100
#
# LAN/host address override: auto (default) = detect on the host;
# none = don't advertise a LAN address; or an explicit IPv4 for
# multi-NIC hosts where detection picks the wrong interface.
# LIVEKIT_NODE_IP=auto
#
# Public address override: auto (default) = STUN-detect at every boot;
# none = air-gapped/LAN-only deploy (also silences the behind-NAT Log
# row); or an explicit IPv4 for cloud 1:1 NAT (e.g. an AWS Elastic IP).
# LIVEKIT_EXTERNAL_IP=auto
#
# TURN over TLS (relay of last resort for callers on networks that
# block direct media). Enabled only when all three are set; the cert
# paths are inside the livekit container, which mounts ./certs at
# /certs. See docs/livekit-networking-notes.md.
# LIVEKIT_TURN_DOMAIN=
# LIVEKIT_TURN_CERT_FILE=/certs/local.crt
# LIVEKIT_TURN_KEY_FILE=/certs/local.key
# LIVEKIT_TURN_TLS_PORT=5349

# ─── Local TLS / SSL ────────────────────────────────────────
# Provisioned by the deploy script (scripts/deploy/main.mjs) when you opt
# into TLS. nginx detects ./certs/local.crt + ./certs/local.key at boot;
# if absent, the stack runs HTTP-only regardless of TLS_HTTP_MODE.
# See docs/local-ssl-notes.md for the full picture.
#   none        — explicit kill switch (no TLS even with certs present)
#   redirect    — port 80 issues 301 to https (default; recommended)
#   both        — port 80 keeps serving content (LAN/internal-tooling case)
#   https-only  — port 80 returns 444 (drops the connection)
# TLS_HTTP_MODE=none
# Externally-visible HTTPS port (used in 301 redirect targets when the
# operator remapped HTTPS_PORT). Defaults to HTTPS_PORT when unset.
# EXT_HTTPS_PORT=443
# Hint to the entrypoint about how aggressive HSTS should be:
#   self-signed | mkcert | byo  → max-age=300 (avoid poisoning Chrome's HSTS)
#   letsencrypt                 → max-age=31536000; includeSubDomains
# TLS_CERT_SOURCE=self-signed

# ─── Per-action permissions (Waves A-E) ───────────────────────
# Controls the dual-read instrumentation introduced in Wave B and the
# enforcement flip in Wave C. Three values:
#   off  — plugin is wired but every requireCan() check no-ops to ALLOW.
#   warn — divergence-soak window: legacy gates stay canonical, the new
#          resolver runs alongside on annotated routes, mismatches land
#          in permissions_divergence_log + show on the SuperUser
#          dashboard at /b3/superuser/permissions/divergences.
#   on   — new resolver is authoritative; legacy gates retired.
# See docs/permissions-overhaul-plan.md for the rollout sequence.
# BBB_PERMISSIONS_ENFORCE=warn

# ─── Cookie hardening ───────────────────────────────────────
# Set to true to mark every session cookie Secure (HTTPS-only). The deploy
# script writes this automatically when you opt into TLS. Required for
# secure-by-default cookies in any TLS deployment; harmless on Railway
# (which terminates TLS upstream and forwards X-Forwarded-Proto).
# COOKIE_SECURE=false

# ─── Let's Encrypt (only when TLS_CERT_SOURCE=letsencrypt) ──
# LETSENCRYPT_DOMAIN=
# LETSENCRYPT_EMAIL=
# LETSENCRYPT_AGREE_TOS=false
# LOG_LEVEL=info
# WORKER_CONCURRENCY=5
# CORS_ORIGIN=https://your-domain.com
# Bare public site root every backend uses to build deep-links (emails, Slack,
# Bolt payloads). Each app appends its own mount (/b3, /beacon, /board, …).
# MUST be set to the address users actually reach the stack at — if other
# machines hit this box by LAN IP or domain, a localhost value sends them to
# their own machine. `./scripts/deploy.sh` sets this automatically; for a bare
# `docker compose up` accessed from other machines, set it by hand here.
# PUBLIC_URL=https://your-domain.com
# VERSION=1.0.0

# ─── OAuth Providers (optional) ──────────────────────────────
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# ─── LiveKit (voice/video calling) ──────────────────────────
# Used by Banter (and future apps) for WebRTC signaling. The deploy
# script (scripts/deploy/main.mjs) generates these values via
# scripts/deploy/shared/secrets.mjs and writes them here automatically;
# the docker-compose adapter then renders infra/livekit/livekit.yaml
# from its template using these values. Setting them by hand is only
# necessary if you are not using the deploy script.
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# Public-facing WebSocket URL the BROWSER uses to connect to LiveKit.
# Default `ws://localhost:7880` is unreachable from any non-host
# browser. Banter API auto-derives a working URL from the request's
# Host header when this is unset, so most operators don't need to
# touch it. Set explicitly when LiveKit is on a separate hostname
# (e.g. `wss://livekit.example.com`).
# LIVEKIT_WS_URL=
# Host-port bindings for LiveKit (see local-ssl notes for context).
# LIVEKIT_RTC_PORT=7880
# LIVEKIT_TCP_PORT=7881

# ─── Voice agent providers (STT / LLM / TTS) ────────────────
# Used by apps/voice-agent to drive the AI voice agent that joins
# calls when ai_agent_mode != 'off'. All optional — when unset the
# voice agent runs in degraded "log-only" mode and the human-only
# parts of the call still work. The LLM provider settings page in
# /b3/settings → AI Providers lets you set these per-org instead of
# at the platform level if you prefer (apps/frontend/src/pages/settings-llm-providers.tsx).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPGRAM_API_KEY=
# LLM_PROVIDER=             # auto-detect, or 'openai' / 'anthropic'
# AGENT_SYSTEM_PROMPT=      # override the default agent personality

# ─── Email / SMTP (optional — logs only if not set) ─────────
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_xxxxx
# SMTP_FROM=noreply@bigbluebam.io

# ─── Documentation Capture (optional) ───────────────────────
# Credentials for the Playwright screenshot capture pipeline.
# Defaults target the seeded dev stack admin user.
DOCS_CAPTURE_USER=admin@example.com
DOCS_CAPTURE_PASSWORD=BigBlueBam-2026-dev-pw

# ─── Blueprint (structured diagrams) ────────────────────────
# blueprint-api runs the ELK auto-layout engine in-process for graphs
# below this node count. Larger graphs are deferred to the worker so
# the request thread stays snappy. Defaults to 200; raise it if you
# routinely have small servers but very dense diagrams and want layout
# to remain synchronous.
# LAYOUT_INPROCESS_NODE_LIMIT=200
