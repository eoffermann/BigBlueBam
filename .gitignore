# Claude Code: local/session state stays private, but shared agent
# definitions and skills are versioned like any other project tooling.
.claude/*
site/.claude/
.claire/
.deploy-state.json
.deploy-state-railway.json
.deploy-state-railway-logs/
# Local TLS certs provisioned by scripts/deploy/main.mjs (self-signed,
# mkcert, BYO, or Let's Encrypt). Never commit cert material.
/certs/
apps/e2e/test-results
apps/e2e/reports
apps/e2e/playwright-report
apps/e2e/.auth
test-results/
AGENT_DEVELOPMENT.md
agents/
# LiveKit deploy artifacts — rendered/detected per machine by
# scripts/livekit/render-config.mjs (host mode and the livekit-config
# compose init service). Never commit these: livekit.yaml carries the
# deployed LIVEKIT_API_SECRET, and .lan-ip / advertised.json carry
# machine-specific network addresses.
infra/livekit/livekit.yaml
infra/livekit/.lan-ip
infra/livekit/advertised.json
# Python bytecode caches (apps/voice-agent)
__pycache__/
*.pyc

# Re-include Claude Code shared agent/skill definitions (overrides the
# .claude/* and agents/ rules above — negations must come last).
!.claude/agents
!.claude/agents/**
!.claude/skills
!.claude/skills/**
# Also share the autonomous-build hook + its PostToolUse wiring (settings.json is
# the project-shared settings; settings.local.json stays personal/ignored).
!.claude/settings.json
!.claude/hooks
!.claude/hooks/**

# Help-docs build scratch (working artifacts, not deliverables)
docs/.help-build/

# Populated screenshot capture skill (packages/docs-capture)
/screenshots/
screenshots.config.json
packages/docs-capture/_probe.mjs
scripts/.gilligan-keys.env

# Generated manual artifacts. The full book (docx + pdf) IS committed so the
# /docs site can serve it; per-app samples and the index-terms sidecar are not.
# Use /* (not the bare dir) so the negations below can re-include specific files.
site/public/downloads/*
!site/public/downloads/BigBlueBam-Manual.pdf
!site/public/downloads/BigBlueBam-Manual.docx
