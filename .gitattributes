# Force LF line endings on files that must be LF-only for POSIX tooling
# (shell scripts, docker entrypoints) regardless of the Windows autocrlf
# setting. Without this, CRLF sneaks in on Windows checkouts and breaks
# the #! interpreter line when the script is mounted or COPYed into a
# Linux container.

*.sh text eol=lf
*.mjs text eol=lf
Dockerfile* text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Railway service config is generated by scripts/gen-railway-configs.mjs and
# consumed by the Railway Linux platform. Pin everything under railway/ to
# LF so autocrlf on Windows hosts cannot introduce spurious CRLF churn.
railway/** text eol=lf

# nginx configs are consumed by the Linux nginx container AND are the input to
# scripts/gen-railway-configs.mjs. Pin to LF: a lone CR from an autocrlf Windows
# checkout made the generator's `/^\s*__HTTP_LISTEN__\s*$/m` regex treat the CR
# as a line boundary and weld `listen 8080;` onto the preceding comment (nginx
# then defaulted to port 80 and every Railway healthcheck on 8080 failed). LF-
# only removes the enabling condition; the generator also strips CR defensively.
infra/nginx/** text eol=lf

# SQL migrations and docs are fine as default (LF on Unix, whatever on Win)
