# LiveKit server config — TEMPLATE.
#
# Rendered to ./infra/livekit/livekit.yaml by the deploy adapter
# (scripts/deploy/platforms/docker-compose.mjs::renderLivekitConfig)
# at deploy time using the LIVEKIT_API_KEY / LIVEKIT_API_SECRET values
# generated by scripts/deploy/shared/secrets.mjs and persisted to .env.
#
# The rendered livekit.yaml is gitignored — never commit deployment
# credentials. If you need to bring the stack up without running the
# deploy script (e.g. fresh checkout), the compose adapter renders this
# file with `devkey:secret` as fallback values so local-only flows
# still work.
#
# ⚠ GOTCHA (Docker Desktop): if livekit.yaml does NOT exist when
# `docker compose up` runs, Docker auto-creates a DIRECTORY at that path
# to satisfy the bind mount, and every later start fails with
# "not a directory: Are you trying to mount a directory onto a file".
# Fix: `Remove-Item infra/livekit/livekit.yaml -Force` (it's an empty
# dir), then re-render — substitute __LIVEKIT_API_KEY__ /
# __LIVEKIT_API_SECRET__ in this template with the values from .env
# (or run the deploy script, which does it for you).
#
# Placeholders (rendered as the env values during deploy; written here
# with extra dashes so they don't get substituted into this comment):
#   --LIVEKIT_API_KEY--     replaced with env LIVEKIT_API_KEY (or devkey)
#   --LIVEKIT_API_SECRET--  replaced with env LIVEKIT_API_SECRET (or secret)

port: 7880
rtc:
  port_range_start: 50000
  port_range_end: 50100
  tcp_port: 7881
  # ICE candidate advertisement.
  #
  # `node_ip` is the address LiveKit puts in the ICE candidate list it
  # sends to every joining client. If that address is unreachable from
  # the client (e.g. 127.0.0.1, the container's internal 172.x bridge
  # IP, or the wrong host on a LAN), the DTLS handshake times out and
  # the docked Bureau box shows a red "error".
  #
  # The renderer picks one of three modes based on LIVEKIT_NODE_IP:
  #   - LIVEKIT_NODE_IP=<ip-or-hostname>  → node_ip: <value>,
  #                                          use_external_ip: false.
  #   - LIVEKIT_NODE_IP="" or unset       → use_external_ip: true (STUN
  #                                          autodetects the public IP).
  #   - LIVEKIT_NODE_IP=auto               → same as the empty case;
  #                                          provided as a memorable opt-in.
  #
  # For a deployment that lives behind a fixed public IP / domain
  # (bigbluebam.com), set LIVEKIT_NODE_IP to that IP in .env so every
  # browser — even one across the network — gets a candidate it can
  # actually reach. The TCP fallback port (7881) is already mapped
  # 0.0.0.0:7881 on the host so the candidate works regardless of
  # whether UDP is reachable.
__LIVEKIT_RTC_BLOCK__
keys:
  __LIVEKIT_API_KEY__: __LIVEKIT_API_SECRET__
webhook:
  urls:
    - http://banter-api:4002/v1/webhooks/livekit
  api_key: __LIVEKIT_API_KEY__
logging:
  level: info
