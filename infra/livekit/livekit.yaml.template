# LiveKit server config — TEMPLATE.
#
# Rendered to ./infra/livekit/livekit.yaml by
# scripts/livekit/render-config.mjs, which runs in two places:
#
#   1. The `livekit-config` one-shot compose service (container mode) —
#      every `docker compose up` re-detects the public (WAN) IP via STUN
#      and re-renders this template before the livekit container starts,
#      so a rotated WAN address never goes stale across restarts.
#   2. The deploy script / operator one-liner (host mode) — detects the
#      host's LAN IP (only possible on the host; containers can't see
#      host interfaces) and persists it to infra/livekit/.lan-ip for the
#      container-mode renders to reuse.
#
# The rendered livekit.yaml, .lan-ip, and advertised.json are all
# gitignored deploy artifacts — no IP address or credential ever lives
# in a tracked file.
#
# How clients on different networks connect (WebRTC ICE): the server
# advertises a LIST of candidate addresses; every client probes all of
# them in parallel at connect time and uses whichever answers. A LAN
# client lands on the LAN IP, a remote client lands on the WAN IP —
# automatically, per-connection. Our job is only to make the list
# complete; that's the rtc-advertise block rendered below.
#
# Placeholders substituted by the renderer (written here with dashes so
# this comment itself doesn't get substituted):
#   --LIVEKIT_API_KEY-- / --LIVEKIT_API_SECRET--   from env (or devkey/secret)
#   --LIVEKIT_UDP_RANGE_START-- / --LIVEKIT_UDP_RANGE_END--
#       from LIVEKIT_UDP_PORT_RANGE (default 51000-51100 — chosen to
#       dodge Windows' reserved 50000-50259 block; the SAME env var
#       drives the docker-compose UDP port mapping so the advertised
#       ports and the host-reachable ports can never drift apart)
#   --LIVEKIT_RTC_ADVERTISE--   nat_1to1_ips list (LAN and/or WAN) or
#       use_external_ip fallback when detection found nothing
#   --LIVEKIT_TURN_BLOCK--      turn server block when LIVEKIT_TURN_DOMAIN
#       + cert/key are configured, empty otherwise

port: 7880
rtc:
  port_range_start: __LIVEKIT_UDP_RANGE_START__
  port_range_end: __LIVEKIT_UDP_RANGE_END__
  tcp_port: 7881
__LIVEKIT_RTC_ADVERTISE__
__LIVEKIT_TURN_BLOCK__
keys:
  __LIVEKIT_API_KEY__: __LIVEKIT_API_SECRET__
webhook:
  urls:
    - http://banter-api:4002/v1/webhooks/livekit
  api_key: __LIVEKIT_API_KEY__
logging:
  level: info
