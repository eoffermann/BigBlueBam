{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/frontend/Dockerfile",
    "watchPatterns": [
      "apps/frontend/**",
      "packages/shared/**",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "package.json",
      "tsconfig.base.json",
      "apps/frontend/Dockerfile",
      "apps/helpdesk/**",
      "apps/banter/**",
      "apps/beacon/**",
      "apps/brief/**",
      "apps/bolt/**",
      "apps/bearing/**",
      "apps/board/**",
      "apps/bond/**",
      "apps/blast/**",
      "apps/book/**",
      "apps/bench/**",
      "apps/basis/**",
      "apps/braid/**",
      "apps/bulwark/**",
      "apps/burn/**",
      "apps/bursar/**",
      "apps/bastion/**",
      "apps/bill/**",
      "apps/blank/**",
      "apps/blueprint/**",
      "apps/bin/**",
      "apps/bay/**",
      "apps/blip/**",
      "apps/bureau/**",
      "packages/ui/**",
      "packages/bureau-client/**",
      "infra/nginx/**"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/b3/",
    "healthcheckTimeout": 100
  }
}
